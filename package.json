{
  "name": "unity-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "PORT=8080 tsx watch src/backend/main.ts --watch src/backend",
    "dev:frontend": "npm start --prefix src/frontends/emandi",
    "build": "npm run build:backend && npm run build:frontend && npm run copy:assets && npm run copy:frontend",
    "build:backend": "tsc --noEmit && tsup",
    "build:frontend": "npm run build --prefix src/frontends/emandi",
    "copy:assets": "mkdir -p dist/backend && cp -R src/backend/assets dist/backend/assets",
    "copy:frontend": "mkdir -p dist/frontends && cp -R src/frontends/emandi/build dist/frontends/emandi",
    "start": "node dist/backend/main.js",
    "prepare": "npm run install-emandi",
    "install-emandi": "npm install --prefix src/frontends/emandi"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "awilix": "^12.0.5",
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^7.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^6.20.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.0.0",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/tough-cookie": "^4.0.5",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3"
  }
}
